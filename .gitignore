# Ignore build directories
/build/
/bin/
/out/
.qtcreator

# Ignore compiled object files
*.o
*.obj
# ...but *.obj also matches Wavefront OBJ mesh assets, which are real
# checked-in files, not build output.
!/tests/assets/*.obj

# Ignore compiled binary executables
*.exe
*.out
*.app
*.dSYM/

# Ignore CMake or other build system files
CMakeCache.txt
CMakeFiles/
CMakeLists.txt.user

# Ignore IDE specific files
.vscode/
.idea/
*.swp
*.swo

# Ignore temporary files
*.log
*.tmp
*.bak
*.old

# Ignore Mac system files
.DS_Store

# Ignore Windows system files
Thumbs.db
Desktop.ini

