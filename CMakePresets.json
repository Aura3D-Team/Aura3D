{
  "version": 11,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_FIND_ROOT_PATH_MODE_PACKAGE": "BOTH",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF"
      }
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux/debug",
      "installDir": "$env{LOCAL_PREFIX}/linux/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/linux/debug"
      }
    },
    {
      "name": "linux-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/linux/release",
      "installDir": "$env{LOCAL_PREFIX}/linux/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/linux/release"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/windows/debug",
      "installDir": "$env{LOCAL_PREFIX}/windows/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/windows/debug"
      }
    },
    {
      "name": "windows-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/windows/release",
      "installDir": "$env{LOCAL_PREFIX}/windows/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/windows/release"
      }
    },
    {
      "name": "macos-debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/macos/debug",
      "installDir": "$env{LOCAL_PREFIX}/macos/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/macos/debug",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "macos-release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/macos/release",
      "installDir": "$env{LOCAL_PREFIX}/macos/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/macos/release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0"
      }
    },
    {
      "name": "ios",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/ios",
      "installDir": "$env{LOCAL_PREFIX}/ios",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.3",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/ios"
      }
    },
    {
      "name": "android",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/android",
      "installDir": "$env{LOCAL_PREFIX}/android",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_shared",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/android"
      }
    },
    {
      "name": "wasm",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/wasm",
      "installDir": "$env{LOCAL_PREFIX}/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{LOCAL_PREFIX}/wasm"
      }
    }
  ],
  "buildPresets": [
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "linux-release", "configurePreset": "linux-release"},
    {"name": "windows-debug", "configurePreset": "windows-debug"},
    {"name": "windows-release", "configurePreset": "windows-release"},
    {"name": "macos-debug", "configurePreset": "macos-debug"},
    {"name": "macos-release", "configurePreset": "macos-release"},
    {"name": "ios", "configurePreset": "ios"},
    {"name": "android", "configurePreset": "android"},
    {"name": "wasm", "configurePreset": "wasm"}
  ]
}
