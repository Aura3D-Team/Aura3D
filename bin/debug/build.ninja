build Aura3D: CXX_EXECUTABLE_LINKER__Aura3D_Debug CMakeFiles/Aura3D.dir/src/GlAura/GlBuffersManager/GlBuffersManager.cpp.o CMakeFiles/Aura3D.dir/src/GlfwAura/GlfwWindowManager/GlfwWindowManager.cpp.o CMakeFiles/Aura3D.dir/src/Runners/GlRunner.cpp.o CMakeFiles/Aura3D.dir/src/Runners/VkRunner.cpp.o CMakeFiles/Aura3D.dir/src/Utils/ShaderSpirvExtractor.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/Vk2DFrameDrawer/Vk2DFrameDrawer.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkBufferManager/VkBufferManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkCommandManager/VkCommandManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkDebugger/VkDebugger.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkDeviceManager/VkDeviceManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkException/VkException.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkFrameBuffersManager/VkFrameBuffersManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkGraphicsPipelineManager/VkGraphicsPipelineManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkImageViewsManager/VkImageViewsManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkInstanceManager/VkInstanceManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkPipelineManager/VkPipelineManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkQueueManager/VkQueueManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkRenderPassManager/VkRenderPassManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkRenderSyncManager/VkRenderSyncManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkShaderManager/VkShaderManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkSurfaceManager/VkSurfaceManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkSwapChainManager/VkSwapChainManager.cpp.o CMakeFiles/Aura3D.dir/src/VkAura/VkVertexBufferManager/VkVertexBufferManager.cpp.o CMakeFiles/Aura3D.dir/src/main.cpp.o | /usr/local/lib/libglfw3.a /usr/local/VulkanSDK/1.4.304.1/x86_64/lib/libvulkan.so || CompileShaders copy_vk_layer_settings
  FLAGS = -DQT_QML_DEBUG -g
  LINK_LIBRARIES = -Wl,-rpath,/usr/local/VulkanSDK/1.4.304.1/x86_64/lib:  /usr/local/lib/libglfw3.a  /usr/local/VulkanSDK/1.4.304.1/x86_64/lib/libvulkan.so  -ldl  -lpthread
  OBJECT_DIR = CMakeFiles/Aura3D.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = Aura3D
  TARGET_PDB = Aura3D.dbg


#############################################
# Utility command for copy_vk_layer_settings

build copy_vk_layer_settings: phony CMakeFiles/copy_vk_layer_settings


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/bin/ccmake -S/workspace/Aura3D -B/workspace/Aura3D/bin/debug
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/bin/cmake --regenerate-during-build -S/workspace/Aura3D -B/workspace/Aura3D/bin/debug
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build list_install_components: phony


#############################################
# Utility command for install

build CMakeFiles/install.util: CUSTOM_COMMAND all
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build install: phony CMakeFiles/install.util


#############################################
# Utility command for install/local

build CMakeFiles/install/local.util: CUSTOM_COMMAND all
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build install/local: phony CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build CMakeFiles/install/strip.util: CUSTOM_COMMAND all
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/bin/cmake -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build install/strip: phony CMakeFiles/install/strip.util


#############################################
# Phony custom command for CMakeFiles/CompileShaders

build CMakeFiles/CompileShaders | ${cmake_ninja_workdir}CMakeFiles/CompileShaders: phony shaders/frag/shader2d_frag.spv shaders/vert/shader2d_vert.spv shaders/frag/shader3d_frag.spv shaders/vert/shader3d_vert.spv shaders/frag/test_shader2d_frag.spv shaders/vert/test_shader2d_vert.spv


#############################################
# Custom command for shaders/frag/shader2d_frag.spv

build shaders/frag/shader2d_frag.spv | ${cmake_ninja_workdir}shaders/frag/shader2d_frag.spv: CUSTOM_COMMAND /workspace/Aura3D/shaders/shader2d.frag
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/VulkanSDK/1.4.304.1/x86_64/bin/glslc /workspace/Aura3D/shaders/shader2d.frag -o /workspace/Aura3D/bin/debug/shaders/frag/shader2d_frag.spv
  DESC = Compiling /workspace/Aura3D/shaders/shader2d.frag to /workspace/Aura3D/bin/debug/shaders/frag/shader2d_frag.spv
  restat = 1


#############################################
# Custom command for shaders/frag/shader3d_frag.spv

build shaders/frag/shader3d_frag.spv | ${cmake_ninja_workdir}shaders/frag/shader3d_frag.spv: CUSTOM_COMMAND /workspace/Aura3D/shaders/shader3d.frag
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/VulkanSDK/1.4.304.1/x86_64/bin/glslc /workspace/Aura3D/shaders/shader3d.frag -o /workspace/Aura3D/bin/debug/shaders/frag/shader3d_frag.spv
  DESC = Compiling /workspace/Aura3D/shaders/shader3d.frag to /workspace/Aura3D/bin/debug/shaders/frag/shader3d_frag.spv
  restat = 1


#############################################
# Custom command for shaders/frag/test_shader2d_frag.spv

build shaders/frag/test_shader2d_frag.spv | ${cmake_ninja_workdir}shaders/frag/test_shader2d_frag.spv: CUSTOM_COMMAND /workspace/Aura3D/shaders/test_shader2d.frag
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/VulkanSDK/1.4.304.1/x86_64/bin/glslc /workspace/Aura3D/shaders/test_shader2d.frag -o /workspace/Aura3D/bin/debug/shaders/frag/test_shader2d_frag.spv
  DESC = Compiling /workspace/Aura3D/shaders/test_shader2d.frag to /workspace/Aura3D/bin/debug/shaders/frag/test_shader2d_frag.spv
  restat = 1


#############################################
# Custom command for shaders/vert/shader2d_vert.spv

build shaders/vert/shader2d_vert.spv | ${cmake_ninja_workdir}shaders/vert/shader2d_vert.spv: CUSTOM_COMMAND /workspace/Aura3D/shaders/shader2d.vert
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/VulkanSDK/1.4.304.1/x86_64/bin/glslc /workspace/Aura3D/shaders/shader2d.vert -o /workspace/Aura3D/bin/debug/shaders/vert/shader2d_vert.spv
  DESC = Compiling /workspace/Aura3D/shaders/shader2d.vert to /workspace/Aura3D/bin/debug/shaders/vert/shader2d_vert.spv
  restat = 1


#############################################
# Custom command for shaders/vert/shader3d_vert.spv

build shaders/vert/shader3d_vert.spv | ${cmake_ninja_workdir}shaders/vert/shader3d_vert.spv: CUSTOM_COMMAND /workspace/Aura3D/shaders/shader3d.vert
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/VulkanSDK/1.4.304.1/x86_64/bin/glslc /workspace/Aura3D/shaders/shader3d.vert -o /workspace/Aura3D/bin/debug/shaders/vert/shader3d_vert.spv
  DESC = Compiling /workspace/Aura3D/shaders/shader3d.vert to /workspace/Aura3D/bin/debug/shaders/vert/shader3d_vert.spv
