#############################################
# Custom command for shaders/vert/test_shader2d_vert.spv

build shaders/vert/test_shader2d_vert.spv | ${cmake_ninja_workdir}shaders/vert/test_shader2d_vert.spv: CUSTOM_COMMAND /workspace/Aura3D/shaders/test_shader2d.vert
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/VulkanSDK/1.4.304.1/x86_64/bin/glslc /workspace/Aura3D/shaders/test_shader2d.vert -o /workspace/Aura3D/bin/debug/shaders/vert/test_shader2d_vert.spv
