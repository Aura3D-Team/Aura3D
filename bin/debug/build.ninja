build CMakeFiles/copy_vk_layer_settings | ${cmake_ninja_workdir}CMakeFiles/copy_vk_layer_settings: CUSTOM_COMMAND
  COMMAND = cd /workspace/Aura3D/bin/debug && /usr/local/bin/cmake -E make_directory /workspace/Aura3D/bin/debug && /usr/local/bin/cmake -E copy_if_different /workspace/Aura3D/vk_layer_settings.txt /workspace/Aura3D/bin/debug/vk_layer_settings.txt

