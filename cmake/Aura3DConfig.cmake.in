@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Every platform installed here shares one set of headers; the library, its
# dependency list and its AURA_HAS_* definitions differ. Resolve the caller's
# ABI tag with the code that produced the name, then load that build's own
# deps and targets.
include("${CMAKE_CURRENT_LIST_DIR}/PlatformSuffix.cmake")
aura3d_resolve_installed_suffix("${CMAKE_CURRENT_LIST_DIR}" "Aura3DTargets" _aura_suffix)

set(_aura_deps    "${CMAKE_CURRENT_LIST_DIR}/Aura3D-deps-${_aura_suffix}.cmake")
set(_aura_targets "${CMAKE_CURRENT_LIST_DIR}/Aura3DTargets-${_aura_suffix}.cmake")

if(NOT EXISTS "${_aura_targets}")
    file(GLOB _aura_have "${CMAKE_CURRENT_LIST_DIR}/Aura3DTargets-*.cmake")
    list(TRANSFORM _aura_have REPLACE "^.*/Aura3DTargets-(.+)\\.cmake$" "\\1")
    list(FILTER _aura_have EXCLUDE REGEX "-(debug|release|relwithdebinfo|minsizerel)$")
    message(FATAL_ERROR "Aura3D is not installed for '${_aura_suffix}'; have: ${_aura_have}")
endif()

include("${_aura_deps}")
include("${_aura_targets}")

unset(_aura_suffix)
unset(_aura_deps)
unset(_aura_targets)
unset(_aura_have)

check_required_components(Aura3D)
