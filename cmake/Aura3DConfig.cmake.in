@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
find_dependency(wma)
find_dependency(ink)

if(@AURA_ENABLE_VULKAN@)
    find_dependency(Vulkan)
endif()

if(@AURA_ENABLE_OPENGL@)
    find_dependency(OpenGL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/Aura3DTargets.cmake")

check_required_components(Aura3D)
